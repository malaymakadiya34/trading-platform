# PostgreSQL connection string used by Prisma.
# Keep real credentials in .env.local; never commit secrets.
DATABASE_URL="postgresql://postgres:password@localhost:5432/trading_platform?schema=public"

# Public origin used for absolute URLs in future server integrations.
APP_URL="http://localhost:3000"

# Canonical market-data provider. Leave blank for the safe UNAVAILABLE state.
# Future activation: MARKET_DATA_PROVIDER="upstox" with a server-only read-only analytics token.
MARKET_DATA_PROVIDER=""
UPSTOX_ANALYTICS_TOKEN=""
# Offline approved EOD/reference dataset; only with provider=development outside production.
DEVELOPMENT_DATASET_PATH=""
# MOCK is accepted only when NODE_ENV is not production.
MARKET_DATA_MODE=""

# Optional realtime cache. The service degrades to bounded in-process cache when unavailable.
REDIS_URL=""
