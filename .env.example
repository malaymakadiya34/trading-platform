# PostgreSQL connection string used by Prisma.
# Keep real credentials in .env.local; never commit secrets.
DATABASE_URL="postgresql://postgres:password@localhost:5432/trading_platform?schema=public"

# Public origin used for absolute URLs in future server integrations.
APP_URL="http://localhost:3000"

# Optional canonical market-data adapter configuration. No vendor is selected by default.
MARKET_DATA_PROVIDER=""
MARKET_DATA_API_URL=""
MARKET_DATA_API_KEY=""
MARKET_DATA_API_SECRET=""
# MOCK is accepted only when NODE_ENV is not production.
MARKET_DATA_MODE=""

# Optional realtime cache. The service degrades to bounded in-process cache when unavailable.
REDIS_URL=""
