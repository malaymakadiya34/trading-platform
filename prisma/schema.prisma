generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ExchangeCode {
  NSE
  BSE
  NFO
  GLOBAL
}

enum InstrumentKind {
  STOCK
  INDEX
  SECTOR
}

enum ContractKind {
  FUTURE
  OPTION
}

enum OptionType {
  CE
  PE
}

enum CandleTimeframe {
  MINUTE_1
  MINUTE_5
  MINUTE_15
  DAILY
}

model User {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String                @map("password_hash")
  name         String?
  role         UserRole              @default(USER)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  sessions     Session[]
  settings     UserSettings?
  resetTokens  PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  timezone  String   @default("Asia/Kolkata")
  theme     String   @default("dark")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Exchange {
  id          String        @id @default(cuid())
  code        ExchangeCode  @unique
  name        String
  timezone    String
  marketOpen  String        @map("market_open")
  marketClose String        @map("market_close")
  instruments Instrument[]
  contracts   Contract[]
  holidays    MarketHoliday[]

  @@map("exchanges")
}

model Instrument {
  id               String              @id @default(cuid())
  exchangeId       String              @map("exchange_id")
  kind             InstrumentKind
  symbol           String
  normalizedSymbol String              @map("normalized_symbol")
  displayName      String              @map("display_name")
  isin             String?
  currency         String              @default("INR")
  isFnoEligible    Boolean             @default(false) @map("is_fno_eligible")
  active           Boolean             @default(true)
  metadata         Json?
  exchange         Exchange            @relation(fields: [exchangeId], references: [id])
  contracts        Contract[]          @relation("UnderlyingContracts")
  quotes           MarketQuote[]
  candles          HistoricalCandle[]
  parentLinks      InstrumentMembership[] @relation("ParentInstrument")
  childLinks       InstrumentMembership[] @relation("ChildInstrument")

  @@unique([exchangeId, normalizedSymbol])
  @@index([kind, active])
  @@index([normalizedSymbol])
  @@map("instruments")
}

model InstrumentMembership {
  id             String     @id @default(cuid())
  parentId       String     @map("parent_id")
  childId        String     @map("child_id")
  weight         Decimal?   @db.Decimal(12, 6)
  effectiveFrom  DateTime   @map("effective_from")
  effectiveTo    DateTime?  @map("effective_to")
  parent         Instrument @relation("ParentInstrument", fields: [parentId], references: [id], onDelete: Cascade)
  child          Instrument @relation("ChildInstrument", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, effectiveFrom])
  @@index([childId])
  @@map("instrument_memberships")
}

model Contract {
  id               String       @id @default(cuid())
  exchangeId       String       @map("exchange_id")
  underlyingId     String       @map("underlying_id")
  kind             ContractKind
  optionType       OptionType?  @map("option_type")
  contractSymbol   String       @map("contract_symbol")
  normalizedSymbol String       @map("normalized_symbol")
  expiry           DateTime
  strike           Decimal?     @db.Decimal(24, 8)
  lotSize          Int?         @map("lot_size")
  tickSize         Decimal?     @db.Decimal(12, 8) @map("tick_size")
  metadata         Json?
  exchange         Exchange     @relation(fields: [exchangeId], references: [id])
  underlying       Instrument   @relation("UnderlyingContracts", fields: [underlyingId], references: [id])
  quotes           MarketQuote[]
  candles          HistoricalCandle[]

  @@unique([exchangeId, normalizedSymbol])
  @@index([underlyingId, expiry, kind])
  @@index([expiry, strike, optionType])
  @@map("contracts")
}

model MarketQuote {
  id           String     @id @default(cuid())
  instrumentId String?    @map("instrument_id")
  contractId   String?    @map("contract_id")
  lastPrice    Decimal    @map("last_price") @db.Decimal(24, 8)
  change       Decimal?   @db.Decimal(24, 8)
  changePct    Decimal?   @map("change_pct") @db.Decimal(12, 6)
  volume       Decimal?   @db.Decimal(30, 8)
  openInterest Decimal?   @map("open_interest") @db.Decimal(30, 8)
  asOf         DateTime   @map("as_of")
  source       String
  isDelayed    Boolean    @default(false) @map("is_delayed")
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  contract     Contract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([instrumentId, asOf])
  @@index([contractId, asOf])
  @@index([asOf])
  @@map("market_quotes")
}

model HistoricalCandle {
  id           String          @id @default(cuid())
  instrumentId String?         @map("instrument_id")
  contractId   String?         @map("contract_id")
  timeframe    CandleTimeframe
  startsAt     DateTime        @map("starts_at")
  open         Decimal         @db.Decimal(24, 8)
  high         Decimal         @db.Decimal(24, 8)
  low          Decimal         @db.Decimal(24, 8)
  close        Decimal         @db.Decimal(24, 8)
  volume       Decimal?        @db.Decimal(30, 8)
  openInterest Decimal?        @map("open_interest") @db.Decimal(30, 8)
  source       String
  instrument   Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  contract     Contract?       @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, contractId, timeframe, startsAt])
  @@index([instrumentId, timeframe, startsAt])
  @@index([contractId, timeframe, startsAt])
  @@map("historical_candles")
}

model InstitutionalActivity {
  id          String   @id @default(cuid())
  tradingDate DateTime @unique @map("trading_date") @db.Date
  fiiBuy      Decimal  @map("fii_buy") @db.Decimal(24, 4)
  fiiSell     Decimal  @map("fii_sell") @db.Decimal(24, 4)
  fiiNet      Decimal  @map("fii_net") @db.Decimal(24, 4)
  inMarket    Decimal  @map("in_market") @db.Decimal(24, 4)
  diiNet      Decimal  @map("dii_net") @db.Decimal(24, 4)
  diiBuy      Decimal  @map("dii_buy") @db.Decimal(24, 4)
  diiSell     Decimal  @map("dii_sell") @db.Decimal(24, 4)
  source      String
  asOf        DateTime @map("as_of")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tradingDate])
  @@map("institutional_activity")
}

model MarketHoliday {
  id          String       @id @default(cuid())
  exchangeId  String       @map("exchange_id")
  tradingDate DateTime     @map("trading_date") @db.Date
  name        String
  exchange    Exchange     @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, tradingDate])
  @@map("market_holidays")
}
